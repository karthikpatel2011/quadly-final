PORT=4000

# Supabase — fill with your project's values; the real ones live only in .env
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres


# Admin panel credentials
ADMIN_EMAIL=admin@yourmail.com
ADMIN_PASSWORD=choose-a-strong-one

# Mail center delivery (SMTP) — until set, admin mail queues in the outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Quadly <you@yourmail.com>"
